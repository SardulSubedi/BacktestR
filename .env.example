# Copy to .env locally. Never commit credentials.
# Leave OPENAI_API_KEY empty to use the explicitly labeled local rule parser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Alpaca market data and the generated paper bot use these names.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# IEX is a single exchange. SIP requires the appropriate subscription.
ALPACA_DATA_FEED=iex
